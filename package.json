{
  "name": "genie-light-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:cms": "yarn workspace @genie-light/cms dev",
    "dev:web": "yarn workspace @genie-light/web dev",
    "build": "turbo run build",
    "build:database": "yarn workspace @genie-light/database build",
    "build:cms": "yarn build:database && yarn workspace @genie-light/cms build",
    "build:web": "yarn build:database && yarn workspace @genie-light/web build",
    "start": "turbo run start",
    "start:cms": "yarn workspace @genie-light/cms start",
    "start:web": "yarn workspace @genie-light/web start",
    "db:generate": "yarn workspace @genie-light/database generate",
    "db:push": "yarn workspace @genie-light/database push",
    "db:seed": "yarn workspace @genie-light/database seed",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "typescript": "^5.0.0"
  },
  "packageManager": "yarn@1.22.22"
}
